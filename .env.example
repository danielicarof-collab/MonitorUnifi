# ============================================================
# UniFi Intelligence Hub — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- UniFi Controller (UDM-Pro) ---
# IP or hostname of your UDM-Pro (include https://)
UNIFI_HOST=https://192.168.1.1

# --- Autenticação (escolha UMA das opções abaixo) ---

# OPÇÃO 1 — API Key (RECOMENDADO para UniFi OS 5.x+ / Network 10.x+)
# Gere em: UniFi OS → Settings → API → Create API Key
# Quando definida, substitui autenticação por username/password.
# Habilita endpoints avançados: /proxy/network/integrations/v1/...
# (métricas detalhadas de CPU, memória, rádio, TX retries, redes)
UNIFI_API_KEY=

# OPÇÃO 2 — Username + Password (legado, firmware antigo)
# Use um usuário local com role "Administrator (Read Only)".
# Não necessário se UNIFI_API_KEY estiver preenchida.
UNIFI_USERNAME=readonly_user
UNIFI_PASSWORD=your_secure_password_here

# Site ID — "default" for most single-site setups
UNIFI_SITE=default

# Set to "true" only if you have a valid SSL certificate
UNIFI_VERIFY_SSL=false

# --- Database ---
# SQLite (default — zero config)
DB_URL=sqlite:///./data/unifi_hub.db

# PostgreSQL alternative (uncomment and configure)
# DB_URL=postgresql://unifi_user:password@localhost:5432/unifi_hub

# --- Collector ---
# How often to poll the UniFi API (seconds)
POLL_INTERVAL_SECONDS=60

# How many past events to fetch per collection cycle
EVENTS_FETCH_LIMIT=3000

# Suspicious activity threshold: blocks per minute per device
SUSPICIOUS_BLOCKS_THRESHOLD=5

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=./data/collector.log
